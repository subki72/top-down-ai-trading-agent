# ==============================================================================
# AI TRADING FIRM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. AI Engine (Groq Cloud) - REQUIRED
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Alert Dispatcher (Telegram Bot) - OPTIONAL
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Web Dashboard Persistence (Supabase) - OPTIONAL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 4. Trading Pair & Exchange Parameters
COIN_SYMBOL=TAO/USD
EXCHANGE_ID=kraken

# 5. Capital Management & Guardrail Thresholds
ACCOUNT_EQUITY=10000.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_CAPITAL_ALLOCATION_PCT=25.0
DEFAULT_LEVERAGE=1.0
MIN_RR_RATIO=1.5
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0

# 6. Observability & Logging
LOG_LEVEL=INFO

# 7. Network Resilience & Timeouts
API_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_INITIAL_DELAY=1.0
RETRY_BACKOFF_FACTOR=2.0

# 8. LLM Model Selection
MODEL_STRATEGIST=llama-3.3-70b-versatile
MODEL_ANALYST=llama-3.3-70b-versatile
MODEL_SNIPER=llama-3.1-8b-instant
MODEL_MANAGER=llama-3.1-8b-instant
MODEL_NEWS=llama-3.1-8b-instant
